# Replace these values with your local PostgreSQL connection settings.
DB_URL=jdbc:postgresql://localhost:5432/moamoa
DB_USERNAME=postgres
DB_PASSWORD=change-me
# JWT signing key. Use a random string of at least 32 characters.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Optional. Comma-separated web frontend origins allowed by CORS (e.g. http://localhost:3000).
CORS_ALLOWED_ORIGINS=
# Optional. SMTP settings for password reset mail (e.g. Gmail: smtp.gmail.com / 587 / app password).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Optional. Web page that opens the password reset link (default: sandbox web).
PASSWORD_RESET_WEB_URL=https://moamoa-sandbox.aandiclub.com
